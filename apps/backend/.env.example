# Copy to apps/backend/.env. Never commit the real file.

# Local Docker Postgres from apps/backend/docker-compose.yml (npm run db:up --workspace=backend).
# DB_HOST must stay localhost in dev: migrations run on boot against whatever host is set.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=blue_star_user
DB_PASSWORD=blue_star_password
DB_DATABASE=blue_star_db
DB_SSL=false
# DATABASE_URL=postgres://user:password@host:5432/db   # optional, replaces the DB_* values above

FINANCIAL_MODELING_PREP_API_KEY=your_api_key_here
SEC_EDGAR_CONTACT_EMAIL=you@example.com

# Push notifications (startup and cron alerts)
NTFY_API_KEY=
# NTFY_BASE_URL=https://ntfy.sh

# Defaults when unset; override only for another Kinde tenant
# KINDE_DOMAIN=bluestar.kinde.com
# KINDE_CLIENT_ID=local-backend

# PORT=3000
# FRONTEND_URL=http://localhost:5173   # CORS origin, must match the frontend port

# Both default to on. Set to false to send no notification / run no scheduled job.
# NOTIFICATIONS_ENABLED=false
# CRON_ENABLED=false
